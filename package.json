{
  "name": "mixagent-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "Cheap scout model explores the code, a flagship planner writes one Markdown plan, a cheap executor applies it in a fresh session.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "prompts.js",
    "plan.js",
    "transcript.js",
    "apply.js",
    "safety.js",
    "pipeline.js",
    "trace.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
